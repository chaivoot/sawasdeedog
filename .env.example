# ---- LINE Login (https://developers.line.biz/console/) ----
# Channel ID 2011815341. Register these Callback URLs in the channel:
#   https://<your-domain>/auth/line/callback
#   http://localhost:3000/auth/line/callback   (local testing)
# Without these, `npm run dev` signs in as a test user; production refuses.
LINE_CHANNEL_ID=2011815341
LINE_CHANNEL_SECRET=

# Long random string that signs the session cookie. Required in production.
# Generate: openssl rand -base64 32
SESSION_SECRET=

# Public origin, e.g. https://sawasdeedog.com (builds the LINE callback URL).
SITE_URL=

# ---- Admins ----
# LINE user IDs (U...) allowed into /admin, comma separated. Sign in at /admin
# with a LINE account that isn't listed and the page shows its ID.
ADMIN_LINE_USER_IDS=

# ---- Supabase (Project Settings -> API) ----
# Without these the site shows built-in sample data and saving is disabled.
SUPABASE_URL=
# Secret: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Public anon/publishable key; only sent as the apikey header on photo uploads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
