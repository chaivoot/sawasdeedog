# LINE Login channel (https://developers.line.biz/console/). Callback URL to
# register: <SITE_URL>/auth/line/callback. Without these, `npm run dev` signs
# in as a test user; production refuses to log in.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Long random string used to sign the session cookie. Required in production.
SESSION_SECRET=

# Public origin, e.g. https://sawasdee.dog (used to build the LINE callback URL).
SITE_URL=
